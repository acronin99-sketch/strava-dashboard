# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Encrypts the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Supabase (for training plan storage - optional, mock data is used if not set)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
